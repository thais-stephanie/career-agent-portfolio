        "section_order": {
          "default": [
            "headline",
            "summary",
            "experience",
            "projects",
            "education",
            "certifications",
            "skills"
          ],
          "items": {
            "pattern": "^(headline|summary|experience|projects|education|certifications|skills|custom:[0-9A-HJKMNP-TV-Z]{26})$",
            "type": "string"
          },
          "title": "Section Order",
          "type": "array"
