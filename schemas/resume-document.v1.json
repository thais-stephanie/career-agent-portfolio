            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "flags": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ClaimFlag"
          },
          "title": "Flags",
          "type": "array"
        },
        "hidden": {
          "default": false,
          "title": "Hidden",
          "type": "boolean"
        },
        "id": {
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
          "title": "Id",
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/Origin"
        },
        "original_text": {
          "anyOf": [
            {
              "maxLength": 5000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Original Text"
        },
        "override": {
          "$ref": "#/$defs/Override",
          "default": "NONE"
        },
        "requirement_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Requirement Ids",
          "type": "array"
        },
        "text": {
          "maxLength": 5000,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "origin",
        "id",
        "text"
      ],
      "title": "Bullet",
      "type": "object"
    },
