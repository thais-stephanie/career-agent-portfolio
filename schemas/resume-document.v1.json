    "Layout": {
      "additionalProperties": false,
      "description": "Which sections show, in what order, under what heading. Not content.",
      "properties": {
        "headings": {
          "default": {},
          "patternProperties": {
            "^(headline|summary|experience|projects|education|certifications|skills|custom:[0-9A-HJKMNP-TV-Z]{26})$": {
              "maxLength": 80,
              "type": "string"
            }
          },
          "title": "Headings",
          "type": "object"
        },
        "hidden_sections": {
          "default": [],
          "items": {
            "pattern": "^(headline|summary|experience|projects|education|certifications|skills|custom:[0-9A-HJKMNP-TV-Z]{26})$",
            "type": "string"
          },
          "title": "Hidden Sections",
          "type": "array"
