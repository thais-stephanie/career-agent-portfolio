  "details": [
   {
    "name": "Description",
    "order": 1,
    "value": "<p>🤓 <a href=\"https://tripleten.com/es-mex/\" target=\"_blank\" rel=\"noopener noreferrer\">Tr</a><a href=\"https://tripleten.com/\" target=\"_blank\" rel=\"noopener noreferrer\">ipleTen</a> is an EdTech company that designs and runs tech career learning programs for the US and Latin American markets. We've been doing it for over five years, teaching complete beginners — people with no prior tech background "
   },
   {
    "name": "What you will do",
    "order": 2,
    "value": "<ul><li>Own and continuously improve our CRM ecosystem, primarily HubSpot and Planhat.</li><li>Design, build, and maintain automations using Make or similar workflow automation platforms.</li><li>Connect and manage integrations across CRM, telephony, and other business-critical systems.</li><li>Administer and optimise the software stack used by Product and Operations teams.</li><li>Identify opport"
   },
   {
    "name": "Requirements",
    "order": 3,
    "value": "<ul><li>3+ years working with CRM platforms such as HubSpot, Salesforce, Zoho, or Pipedrive.</li><li>Proven track record of owning business processes from discovery and requirements gathering through implementation, optimisation, and ongoing support.</li><li>Proficiency in building automations and workflows using Make, Zapier, n8n, Workato, or similar tools.</li><li>Solid understanding of software"
   },
   {
    "name": "What we can offer you",
    "order": 4,
    "value": "<ul><li>High autonomy to explore, test, and improve processes.</li><li>Competitive compensation.</li><li>Fully remote collaboration.</li><li>Work alongside an experienced, global professional team.</li><li>A digital office — we use modern tools (Notion, Miro, Slack, Figma) to keep collaboration smooth.</li><li>Professional trust and autonomy — no micromanaging.</li></ul>"
   }
  ]
 },
